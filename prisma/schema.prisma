generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Organization {
  id                 String             @id @default(cuid())
  name               String             // organization_name
  slug               String             @unique
  plan               String             @default("TRIAL") // STARTER, GROWTH, PRO, ENTERPRISE
  subscriptionStatus String             @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED
  aiCredits          Int                @default(0) // ai_credits
  status             String             @default("ACTIVE") // ACTIVE, SUSPENDED, ARCHIVED
  
  users              Membership[]
  invites            Invite[]
  campaigns          Campaign[]
  usageLogs          UsageLog[]
  modelSettings      ModelSetting[]
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  firstName       String?
  lastName        String?
  jobTitle        String?
  passwordHash    String?
  status          String         @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED, ARCHIVED
  lastLogin       DateTime?
  
  memberships     Membership[]
  auditLogs       AuditLog[]
  usageLogs       UsageLog[]
  loginHistory    LoginHistory[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           String       @default("VIEWER") // SUPER_ADMIN, CLIENT_ADMIN, EDITOR, REVIEWER, VIEWER
  status         String       @default("ACTIVE")
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
}

model Invite {
  id             String    @id @default(cuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           String
  inviteToken    String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  status         String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED

  createdAt      DateTime  @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id])
  action       String   // e.g., "CREATE_USER", "EDIT_USER"
  targetType   String   // e.g., "USER", "ORGANIZATION"
  targetId     String?
  metadata     String?  // JSON string
  createdAt    DateTime @default(now())
}

model Campaign {
  id             String        @id @default(cuid())
  name           String
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  
  rows           CampaignRow[]
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model CampaignRow {
  id                 String           @id @default(cuid())
  campaignId         String
  campaign           Campaign         @relation(fields: [campaignId], references: [id])
  
  sourceRowId        String
  businessName       String?
  contactEmail       String?
  contactName        String?
  
  validationStatus   String           @default("PENDING") // PENDING, VALID, INVALID
  strategyId         String?
  draftId            String?
  qaScore            Float?
  approvalStatus     String           @default("PENDING") // PENDING, APPROVED, REJECTED
  
  usageLogs          UsageLog[]
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model UsageLog {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  
  campaignId       String?
  campaignRowId    String?
  campaignRow      CampaignRow? @relation(fields: [campaignRowId], references: [id])
  
  action           String       // VALIDATE, STRATEGY, DRAFT, QA, REPLY
  modelUsed        String
  creditsCharged   Int
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  estimatedApiCost Float?
  success          Boolean      @default(true)
  errorMessage     String?
  
  timestamp        DateTime     @default(now())
}

model ModelSetting {
  id              String       @id @default(cuid())
  organizationId  String
  organization     Organization @relation(fields: [organizationId], references: [id])
  
  taskName        String       // ORC_INTAKE, SENTINEL_STRATEGY, etc.
  selectedModel   String
  purpose         String?
  temperature     Float        @default(0.7)
  maxOutputLength Int          @default(2000)
  costMode        String       @default("BALANCED") // QUALITY, BALANCED, ECONOMY
  isActive        Boolean      @default(true)
  fallbackModel   String?
  notes           String?
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model SubscriptionPlan {
  id                 String         @id @default(cuid())
  name               String         @unique // STARTER, GROWTH, PRO, ENTERPRISE
  monthlyCreditLimit Int
  basePrice          Float
  features           String         // JSON string of allowed features
  
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model CreditRule {
  id          String   @id @default(cuid())
  actionName  String   @unique // VALIDATE, STRATEGY, etc.
  creditCost  Int
  description String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
