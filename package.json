{
  "name": "vrf-campaign-orchestrator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/patch-open-next-output.mjs",
    "start": "next start",
    "preview": "npm run build:cloudflare && wrangler dev --env demo",
    "deploy:demo": "npm run build:cloudflare && wrangler deploy --env demo",
    "deploy:test-live": "npm run build:cloudflare && wrangler deploy --env test-live",
    "db:migrate": "wrangler d1 migrations apply emailorc-demo-db --local --env demo",
    "db:migrate:demo": "wrangler d1 migrations apply emailorc-demo-db --remote --env demo",
    "db:migrate:test-live": "wrangler d1 migrations apply emailorc-test-live-db --remote --env test-live",
    "db:seed": "wrangler d1 execute emailorc-demo-db --local --env demo --file=./d1/seed/demo.sql",
    "db:seed:demo": "wrangler d1 execute emailorc-demo-db --remote --env demo --file=./d1/seed/demo.sql",
    "db:seed:test-live": "wrangler d1 execute emailorc-test-live-db --remote --env test-live --file=./d1/seed/demo.sql",
    "lint": "next lint",
    "test": "vitest run tests/validation.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:safe": "playwright test tests/e2e/non-mutating-smoke.spec.ts",
    "test:e2e:report": "playwright show-report playwright-report"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^1.14.0",
    "next": "14.2.5",
    "papaparse": "^5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1044.0",
    "@aws-sdk/client-s3": "^3.1044.0",
    "@opennextjs/cloudflare": "^0.6.6",
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.8",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "path-to-regexp": "^8.4.2",
    "postcss": "^8.5.14",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2",
    "wrangler": "^4.88.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
